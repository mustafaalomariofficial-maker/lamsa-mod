{
  "schemaVersion": 1,
  "id": "lamsa",
  "version": "${version}",
  "name": "لمسة - Lamsa Touch",
  "description": "مود لمس كامل لماين كرافت جافا: عصا حركة وأزرار قابلة للتحريك تدعم أزرار كل المودات، والتحول إلى أي كائن أو بلوك. من صنع ابو بكسل (Abu Pixel).",
  "authors": [
    "ابو بكسل (Abu Pixel)",
    "Lamsa"
  ],
  "license": "MIT",
  "icon": "assets/lamsa/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.lamsa.LamsaMod"
    ],
    "client": [
      "dev.lamsa.client.LamsaClient"
    ]
  },
  "mixins": [
    {
      "config": "lamsa.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
